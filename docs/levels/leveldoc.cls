% The class of the level documents (docs/levels/README.md). Each docs/levels/<slug>/doc.tex
% starts with \documentclass{leveldoc}; scripts/level_docs.py compiles it with LuaLaTeX in
% target/level-docs/<slug>/, next to the files it generates there:
%   levelinfo.tex    the document's number, title, arc, level file, and every document's
%                    number and title (for \levelref)
%   values.tex       every number calc.py computed (\val{name})
%   comparison.tex   the document's numbers against the game's (\comparisontable)
%   setup.tex        the level file's contents as a table (\setuptable)
%   description.tex  the level's text in the game (\leveldescription)
%   level.json       the level file itself (\levelfileappendix)
% Authors do not edit this class; a missing macro is a request to the owner (README.md).
\NeedsTeXFormat{LaTeX2e}
\ProvidesClass{leveldoc}[2026/10/16 Level documents of Electromagnetism the game]
\LoadClass[11pt,a4paper]{article}

\RequirePackage{iftex}
\RequireLuaTeX
\RequirePackage[margin=2.3cm,top=2.2cm,bottom=2.6cm]{geometry}
\RequirePackage{mathtools}
\RequirePackage{amsthm}
\RequirePackage{fontspec}
% Glyphs the text fonts lack come from these (as in PHYSICS.pdf).
\directlua{luaotfload.add_fallback("leveldocfallback", {
  "STIXTwoMath-Regular:mode=harf;", "DejaVuSans:mode=harf;"})}
\setmainfont{Libertinus Serif}[RawFeature={fallback=leveldocfallback}]
\setsansfont{Libertinus Sans}[RawFeature={fallback=leveldocfallback}]
\setmonofont{DejaVu Sans Mono}[Scale=0.82,RawFeature={fallback=leveldocfallback}]
\RequirePackage[warnings-off={mathtools-colon,mathtools-overbracket}]{unicode-math}
\setmathfont{Libertinus Math}
\RequirePackage{xcolor}
\definecolor{docblue}{HTML}{1F3F74}
\definecolor{doclink}{HTML}{2A5DB0}
\definecolor{resultback}{HTML}{EEF3FA}
\definecolor{assumeback}{HTML}{FFF6E5}
\definecolor{assumeframe}{HTML}{B07A1A}
\RequirePackage{booktabs,longtable,array,tabularx,multirow}
\renewcommand{\arraystretch}{1.15}
\RequirePackage{enumitem}
\setlist{topsep=3pt,itemsep=2pt,parsep=1pt}
\RequirePackage[font=small,labelfont=bf]{caption}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,calc,decorations.markings,patterns}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usepgfplotslibrary{groupplots}
\RequirePackage[most]{tcolorbox}
\RequirePackage{fvextra}
\RequirePackage{siunitx}
\sisetup{exponent-product=\times, group-minimum-digits=5, group-separator={\,},
  output-decimal-marker={.}, print-unity-mantissa=false}
\RequirePackage[hyphens]{url}
\RequirePackage{xr-hyper}
\RequirePackage[colorlinks,linkcolor=doclink,urlcolor=doclink,citecolor=doclink,
  filecolor=doclink]{hyperref}
\RequirePackage{bookmark}
\RequirePackage{titlesec}
\titleformat{\section}{\Large\bfseries\color{docblue}}{\thesection}{0.6em}{}
\titleformat{\subsection}{\large\bfseries}{\thesubsection}{0.5em}{}
\titleformat{\subsubsection}{\normalsize\bfseries}{\thesubsubsection}{0.5em}{}
\titlespacing*{\section}{0pt}{18pt}{6pt}
\titlespacing*{\subsection}{0pt}{12pt}{4pt}
\titlespacing*{\paragraph}{0pt}{4pt}{0.8em}
\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{2}
\setlength{\parindent}{0pt}
\setlength{\parskip}{5pt plus 2pt minus 1pt}
\emergencystretch=3em

% ---- The document's identity (generated by scripts/level_docs.py) ------------------------
% \DocEntry{slug}{number}{title}{1 if the level has a document, else 0}: every level of the
% curriculum and the Foundations, for \levelref. levelinfo.tex also defines \DocSlug,
% \DocNumber, \DocTitle, \DocArc, \DocTier, \DocLevelFile (the last three as text).
\newcommand{\DocEntry}[4]{%
  \expandafter\def\csname doc@num@#1\endcsname{#2}%
  \expandafter\def\csname doc@title@#1\endcsname{#3}%
  \expandafter\def\csname doc@has@#1\endcsname{#4}}
\InputIfFileExists{levelinfo.tex}{}{%
  \ClassError{leveldoc}{levelinfo.tex not found}{Build with python scripts/level_docs.py build}}
% Equations, figures and tables carry the document's number: (1.7) is Level 1's seventh
% equation in every document, (F.3) the Foundations' third.
\renewcommand{\theequation}{\DocNumber.\arabic{equation}}
\renewcommand{\thefigure}{\DocNumber.\arabic{figure}}
\renewcommand{\thetable}{\DocNumber.\arabic{table}}
\def\doc@Fnum{F}
\def\DocHeading{\ifx\DocNumber\doc@Fnum Foundations\else Level \DocNumber: \DocTitle\fi}
\AtBeginDocument{\hypersetup{pdftitle={\DocHeading},pdfauthor={Electromagnetism the game}}}

% ---- References ----------------------------------------------------------------------------
% \DocUses{foundations,first_bend}: the documents this one cites by equation, section,
% figure or assumption (only the Foundations and earlier levels; scripts/level_docs.py
% builds them first). Their labels are used as `slug:label`.
\ExplSyntaxOn
\NewDocumentCommand{\DocUses}{m}
  { \clist_map_inline:nn {#1} { \externaldocument[##1:]{../##1/doc}[##1.pdf] } }
\ExplSyntaxOff
% \DocFingerprint{...}: the fingerprint of the level file the text was last reviewed
% against (scripts/level_docs.py check warns when the level has changed since).
\newcommand{\DocFingerprint}[1]{\def\doc@fingerprint{#1}}
% "Level N (Title)", linked to its document; the Foundations by name.
\newcommand{\levelref}[1]{%
  \ifcsname doc@num@#1\endcsname
    \edef\doc@n{\csname doc@num@#1\endcsname}%
    \ifx\doc@n\doc@Fnum
      \href{foundations.pdf}{the Foundations}%
    \else
      \if1\csname doc@has@#1\endcsname
        \href{\detokenize{#1}.pdf}{Level~\doc@n\ (\emph{\csname doc@title@#1\endcsname})}%
      \else
        Level~\doc@n\ (\emph{\csname doc@title@#1\endcsname})%
      \fi
    \fi
  \else
    \ClassError{leveldoc}{Unknown level `\detokenize{#1}'}{Use a slug from levels/curriculum.json}%
  \fi}
% An equation, section, figure, table or assumption of another document listed in \DocUses:
% \xeqref{first_bend}{eq:orbit} gives "(1.7)" (equations carry their document's number),
% \xref{...}{...} the bare number, \xsecref{foundations}{sec:board} "§F.5" and
% \xsecref{first_bend}{sec:time} "Level 1, §4.5".
\newcommand{\xeqref}[2]{\eqref{#1:#2}}
\newcommand{\xref}[2]{\ref{#1:#2}}
\newcommand{\xsecref}[2]{%
  \edef\doc@n{\csname doc@num@#1\endcsname}%
  \ifx\doc@n\doc@Fnum
    §F.\ref{#1:#2}%
  \else
    \href{\detokenize{#1}.pdf}{Level~\doc@n}, §\ref{#1:#2}%
  \fi}
% A section of PHYSICS.md (the engine's model, method and tests), linked to PHYSICS.pdf.
\newcommand{\physref}[1]{\href{../../../PHYSICS.pdf}{\textsf{PHYSICS.md}~§#1}}
% Paths and identifiers in the repository (write \_ for an underscore).
\newcommand{\code}[1]{\texttt{#1}}

% ---- Numbers from calc.py -------------------------------------------------------------------
\newcommand{\DocValue}[2]{\expandafter\def\csname docval@#1\endcsname{#2}}
\newcommand{\DocRawValue}[2]{\expandafter\def\csname docraw@#1\endcsname{#2}}
\InputIfFileExists{values.tex}{}{}
% \val{name}: the value, typeset (\num{...}); \rawval{name}: the bare number, for TikZ
% coordinates and pgfplots options.
\newcommand{\val}[1]{%
  \ifcsname docval@#1\endcsname
    \csname docval@#1\endcsname
  \else
    \ClassError{leveldoc}{No value `\detokenize{#1}'}{calc.py must define it: doc.value("#1", ...)}%
    \textbf{??}%
  \fi}
\newcommand{\rawval}[1]{%
  \ifcsname docraw@#1\endcsname
    \csname docraw@#1\endcsname
  \else
    \ClassError{leveldoc}{No numeric value `\detokenize{#1}'}{calc.py must define it: doc.value("#1", ...)}%
    0%
  \fi}

% ---- Generated material ----------------------------------------------------------------------
\newcommand{\leveldescription}{\InputIfFileExists{description.tex}{}{}}
\newcommand{\setuptable}{\InputIfFileExists{setup.tex}{}{}}
\newcommand{\comparisontable}{\InputIfFileExists{comparison.tex}{}{%
  \ClassError{leveldoc}{comparison.tex not found}{calc.py must call doc.compare}}}
\newcommand{\levelfileappendix}{%
  \section*{Appendix: the level file}
  \addcontentsline{toc}{section}{Appendix: the level file}
  The level as the game loads it (\code{\DocLevelFile}), verbatim: every number of the
  setup comes from here.
  \VerbatimInput[breaklines,breakanywhere,fontsize=\footnotesize,frame=lines,
    framesep=6pt]{level.json}}

% ---- Notation ---------------------------------------------------------------------------------
\newcommand{\vect}[1]{\symbfit{#1}}
\newcommand{\uvec}[1]{\hat{\symbfit{#1}}}
\newcommand{\dd}{\mathrm{d}}
\newcommand{\deriv}[2]{\frac{\dd #1}{\dd #2}}
\newcommand{\pderiv}[2]{\frac{\partial #1}{\partial #2}}
\newcommand{\abs}[1]{\left\lvert #1\right\rvert}
\newcommand{\norm}[1]{\left\lVert #1\right\rVert}
\newcommand{\order}[1]{\mathcal{O}\!\left(#1\right)}
\newcommand{\ex}{\mathrm{e}}
\newcommand{\ii}{\mathrm{i}}

% ---- Environments -----------------------------------------------------------------------------
% The principles a derivation starts from (each cited: the Foundations or a textbook).
\newenvironment{principles}
  {\par\smallskip\noindent{\sffamily\bfseries\small\color{docblue}Principles used}%
   \begin{itemize}[leftmargin=1.6em]}
  {\end{itemize}}
% An assumption or approximation, numbered A1, A2, ...: what is assumed, why it holds, and
% the size of what it neglects. \label right after \begin{assumption}{...}.
\newcounter{assumption}
\renewcommand{\theassumption}{A\arabic{assumption}}
\newenvironment{assumption}[1]
  {\refstepcounter{assumption}%
   \begin{tcolorbox}[enhanced,breakable,colback=assumeback,colframe=assumeframe,
     boxrule=0.5pt,arc=2pt,left=6pt,right=6pt,top=3pt,bottom=3pt,
     title={Assumption \theassumption: #1},fonttitle=\sffamily\bfseries\small,
     coltitle=black,colbacktitle=assumeback!75!assumeframe]}
  {\end{tcolorbox}}
% A key result, boxed: \begin{result}[Title] ... \end{result}.
\newenvironment{result}[1][Result]
  {\begin{tcolorbox}[enhanced,breakable,colback=resultback,colframe=docblue,
     boxrule=0.6pt,arc=2pt,left=6pt,right=6pt,top=3pt,bottom=3pt,
     title={#1},fonttitle=\sffamily\bfseries\small]}
  {\end{tcolorbox}}
% The steps of a computation by hand: \begin{procedure} \item ... \end{procedure}.
\newlist{procedure}{enumerate}{1}
\setlist[procedure]{label=\textbf{Step \arabic*.},ref=\arabic*,leftmargin=*,align=left,
  itemsep=4pt}
\theoremstyle{remark}
\newtheorem*{remark}{Remark}

% ---- The literature (cite a section number only where it was checked) -------------------------
\newcommand{\Jackson}[1]{J.~D. Jackson, \emph{Classical Electrodynamics}, 3rd~ed.\ (Wiley, 1999), #1}
\newcommand{\LandauII}[1]{L.~D. Landau and E.~M. Lifshitz, \emph{The Classical Theory of Fields}, 4th~ed.\ (Pergamon, 1975), #1}
\newcommand{\Goldstein}[1]{H. Goldstein, C. Poole and J. Safko, \emph{Classical Mechanics}, 3rd~ed.\ (Addison-Wesley, 2002), #1}
\newcommand{\Griffiths}[1]{D.~J. Griffiths, \emph{Introduction to Electrodynamics}, 4th~ed.\ (Cambridge University Press, 2017), #1}
\newcommand{\Brau}[1]{C.~A. Brau, \emph{Modern Problems in Classical Electrodynamics} (Oxford University Press, 2004), #1}
\newcommand{\HairerI}[1]{E. Hairer, S.~P. Nørsett and G. Wanner, \emph{Solving Ordinary Differential Equations~I}, 2nd~ed.\ (Springer, 1993), #1}

% ---- The title block, typeset by the class ----------------------------------------------------
\AddToHook{begindocument/end}{%
  \begingroup
  \noindent{\sffamily\small\color{docblue}Electromagnetism the game\hfill
    \ifx\DocNumber\doc@Fnum The physics behind every level\else\DocArc\ \textperiodcentered\ \DocTier\fi}\par
  \vspace{4pt}
  \noindent{\sffamily\bfseries\huge\color{docblue}\DocHeading}\par
  \vspace{3pt}
  \noindent{\small\itshape
    \ifx\DocNumber\doc@Fnum
      The principles, units and conventions every level document builds on.
    \else
      The physics of this level, derived from first principles: enough to compute the
      game's outcome by hand.
    \fi}\par
  \vspace{2pt}
  \noindent{\footnotesize\color{black!60}Typeset from \code{docs/levels/\DocSlugText/doc.tex}%
    \ifx\DocNumber\doc@Fnum\else; level file \code{\DocLevelFile}\fi; \today.}\par
  \vspace{4pt}\hrule\vspace{6pt}
  \endgroup}
\endinput
